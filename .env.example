# Copy to .env and fill in. Never commit .env.
# MODE: backtest (default) | paper | live. Live also needs LIVE_ARMED and
# live_enabled: true in config/risk.yaml; only the human sets these.
MODE=backtest

BROKER_USER_ID=your-broker-user-id
BROKER_PASSWORD=your-broker-password
BROKER_API_KEY=your-broker-api-key
BROKER_API_SECRET=your-broker-api-secret
BROKER_TOTP_SECRET=your-totp-base32-secret

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
